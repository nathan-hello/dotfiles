#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s [timeout_seconds]\n' "${0##*/}" >&2
}

csv_escape() {
  local value=${1:-}
  value=${value//\"/\"\"}
  printf '"%s"' "$value"
}

cleanup() {
  rm -rf "${tmpdir:-}"
}

on_interrupt() {
  trap - INT TERM EXIT
  kill 0 2>/dev/null || true
  cleanup
  exit 130
}

scan() {
  local scan_timeout=$1
  local resolve_timeout=${RESOLVE_TIMEOUT:-0.8}
  local ping_timeout=${PING_TIMEOUT:-0.4}

  declare -A hosts=()
  declare -A ips_by_host=()
  declare -A mac_by_ip=()
  declare -A services_by_host=()

  local tmp_mdns="$tmpdir/mdns"
  local tmp_avahi="$tmpdir/avahi"
  local tmp_hosts="$tmpdir/hosts"
  local tmp_resolved="$tmpdir/resolved"
  local tmp_ips="$tmpdir/ips"

  : >"$tmp_mdns"
  : >"$tmp_avahi"
  : >"$tmp_resolved"
  : >"$tmp_ips"

  timeout --kill-after=0.2s "$scan_timeout" mdns-scan \
    >"$tmp_mdns" 2>/dev/null &
  local pid_mdns=$!

  timeout --kill-after=0.2s "$scan_timeout" avahi-browse -rtp -a \
    >"$tmp_avahi" 2>/dev/null &
  local pid_avahi=$!

  wait "$pid_mdns" 2>/dev/null || true
  wait "$pid_avahi" 2>/dev/null || true

  while IFS= read -r line; do
    while [[ $line =~ ([A-Za-z0-9._-]+\.local) ]]; do
      hosts["${BASH_REMATCH[1]}"]=1
      line="${line#*${BASH_REMATCH[1]}}"
    done
  done <"$tmp_mdns"

  while IFS=';' read -r marker iface proto name stype domain host ip port rest; do
    [[ $marker == '=' ]] || continue
    [[ -n ${host:-} ]] || continue

    hosts["$host"]=1

    if [[ -n ${ip:-} ]]; then
      ips_by_host["$host"]="$ip"
      printf '%s\n' "$ip" >>"$tmp_ips"
    fi

    local service_label="$stype"
    if [[ -n ${name:-} ]]; then
      service_label+=" (${name})"
    fi

    if [[ -n ${services_by_host["$host"]:-} ]]; then
      services_by_host["$host"]+=", ${service_label}"
    else
      services_by_host["$host"]="$service_label"
    fi
  done <"$tmp_avahi"

  printf '%s\n' "${!hosts[@]}" | sort -u >"$tmp_hosts"

  # Resolve missing IPs concurrently. Do not spend the full scan timeout per host.
  while IFS= read -r host; do
    [[ -n $host ]] || continue
    [[ -z ${ips_by_host["$host"]:-} ]] || continue

    {
      local resolved ip_addr

      resolved="$(
        timeout --kill-after=0.1s "$resolve_timeout" \
          avahi-resolve-host-name "$host" 2>/dev/null || true
      )"

      ip_addr="$(awk '{print $2; exit}' <<<"$resolved")"

      if [[ -n $ip_addr ]]; then
        printf '%s\t%s\n' "$host" "$ip_addr"
      fi
    } >>"$tmp_resolved" &
  done <"$tmp_hosts"

  wait

  while IFS=$'\t' read -r host ip_addr; do
    [[ -n ${host:-} && -n ${ip_addr:-} ]] || continue
    ips_by_host["$host"]="$ip_addr"
    printf '%s\n' "$ip_addr" >>"$tmp_ips"
  done <"$tmp_resolved"

  sort -u "$tmp_ips" -o "$tmp_ips"

  # Best-effort neighbor-cache population in parallel.
  while IFS= read -r ip_addr; do
    [[ -n $ip_addr ]] || continue

    {
      timeout --kill-after=0.1s "$ping_timeout" \
        ping -c 1 -W 1 "$ip_addr" >/dev/null 2>&1 || true
    } &
  done <"$tmp_ips"

  wait

  printf 'hostname,ip,mac,services\n'

  while IFS= read -r host; do
    [[ -n $host ]] || continue

    local ip_addr="${ips_by_host["$host"]:-}"
    local mac=""
    local services="${services_by_host["$host"]:-}"

    if [[ -n $ip_addr ]]; then
      if [[ -z ${mac_by_ip["$ip_addr"]+x} ]]; then
        mac_by_ip["$ip_addr"]="$(ip neigh show to "$ip_addr" |
          awk '{print $5; exit}')"
      fi

      mac="${mac_by_ip["$ip_addr"]:-}"
    fi

    printf '%s,%s,%s,%s\n' \
      "$(csv_escape "$host")" \
      "$(csv_escape "$ip_addr")" \
      "$(csv_escape "$mac")" \
      "$(csv_escape "$services")"
  done <"$tmp_hosts"
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

scan_timeout="$1"

if ! [[ "$scan_timeout" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  printf 'Invalid timeout: %s\n' "$scan_timeout" >&2
  usage
  exit 1
fi

for cmd in \
  mdns-scan \
  avahi-browse \
  avahi-resolve-host-name \
  timeout \
  ip \
  ping \
  awk \
  sort \
  tee \
  nvim; do
  command -v "$cmd" >/dev/null 2>&1 || {
    printf 'Missing required command: %s\n' "$cmd" >&2
    exit 1
  }
done

tmpdir="$(mktemp -d)"
trap cleanup EXIT
trap on_interrupt INT TERM

tmp_csv="$(mktemp).csv"

scan "$scan_timeout" | tee "$tmp_csv"

printf '%s\n' "$tmp_csv"

nvim "$tmp_csv" +'%Tabularize /,' +':w'
