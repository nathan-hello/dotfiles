#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s [timeout_seconds]\n' "${0##*/}" >&2
}

csv_escape() {
  local value=${1:-}
  value=${value//\"/\"\"}
  printf '"%s"' "$value"
}

cleanup() {
  rm -rf "${tmpdir:-}"
}

on_interrupt() {
  trap - INT TERM EXIT
  kill 0 2>/dev/null || true
  cleanup
  exit 130
}

append_unique_value() {
  local current=$1
  local value=$2
  local delim=${3:-" | "}

  [[ -n $value ]] || {
    printf '%s' "$current"
    return
  }

  case "$delim$current$delim" in
    *"$delim$value$delim"*) printf '%s' "$current" ;;
    *)
      if [[ -n $current ]]; then
        printf '%s%s%s' "$current" "$delim" "$value"
      else
        printf '%s' "$value"
      fi
      ;;
  esac
}

is_ipv6() {
  [[ $1 == *:* ]]
}

scan() {
  local scan_timeout=$1
  local resolve_timeout=${RESOLVE_TIMEOUT:-0.8}
  local ping_timeout=${PING_TIMEOUT:-0.4}
  local cell_delim=" | "

  declare -A hosts=()
  declare -A ipv4_by_host=()
  declare -A ipv6_by_host=()
  declare -A mac_by_ip=()
  declare -A services_by_host=()

  local tmp_mdns="$tmpdir/mdns"
  local tmp_avahi="$tmpdir/avahi"
  local tmp_hosts="$tmpdir/hosts"
  local tmp_resolved="$tmpdir/resolved"
  local tmp_ips="$tmpdir/ips"

  : >"$tmp_mdns"
  : >"$tmp_avahi"
  : >"$tmp_resolved"
  : >"$tmp_ips"

  timeout --kill-after=0.2s "$scan_timeout" mdns-scan \
    >"$tmp_mdns" 2>/dev/null &
  local pid_mdns=$!

  timeout --kill-after=0.2s "$scan_timeout" avahi-browse -rtp -a \
    >"$tmp_avahi" 2>/dev/null &
  local pid_avahi=$!

  wait "$pid_mdns" 2>/dev/null || true
  wait "$pid_avahi" 2>/dev/null || true

  while IFS= read -r line; do
    while [[ $line =~ ([A-Za-z0-9._-]+\.local) ]]; do
      hosts["${BASH_REMATCH[1]}"]=1
      line="${line#*${BASH_REMATCH[1]}}"
    done
  done <"$tmp_mdns"

  while IFS=';' read -r marker iface proto name stype domain host ip port rest; do
    [[ $marker == '=' ]] || continue
    [[ -n ${host:-} ]] || continue

    hosts["$host"]=1

    if [[ -n ${ip:-} ]]; then
      if is_ipv6 "$ip"; then
        ipv6_by_host["$host"]="$(append_unique_value \
          "${ipv6_by_host["$host"]:-}" "$ip" "$cell_delim")"
      else
        ipv4_by_host["$host"]="$(append_unique_value \
          "${ipv4_by_host["$host"]:-}" "$ip" "$cell_delim")"
      fi

      printf '%s\n' "$ip" >>"$tmp_ips"
    fi

    local service_label="$stype"
    if [[ -n ${name:-} ]]; then
      service_label+=" (${name})"
    fi

    services_by_host["$host"]="$(append_unique_value \
      "${services_by_host["$host"]:-}" "$service_label" "$cell_delim")"
  done <"$tmp_avahi"

  printf '%s\n' "${!hosts[@]}" | sort -u >"$tmp_hosts"

  while IFS= read -r host; do
    [[ -n $host ]] || continue

    {
      local resolved

      resolved="$(
        timeout --kill-after=0.1s "$resolve_timeout" \
          avahi-resolve-host-name "$host" 2>/dev/null || true
      )"

      awk -v host="$host" 'NF >= 2 { print host "\t" $2 }' <<<"$resolved"
    } >>"$tmp_resolved" &
  done <"$tmp_hosts"

  wait

  while IFS=$'\t' read -r host ip_addr; do
    [[ -n ${host:-} && -n ${ip_addr:-} ]] || continue

    if is_ipv6 "$ip_addr"; then
      ipv6_by_host["$host"]="$(append_unique_value \
        "${ipv6_by_host["$host"]:-}" "$ip_addr" "$cell_delim")"
    else
      ipv4_by_host["$host"]="$(append_unique_value \
        "${ipv4_by_host["$host"]:-}" "$ip_addr" "$cell_delim")"
    fi

    printf '%s\n' "$ip_addr" >>"$tmp_ips"
  done <"$tmp_resolved"

  sort -u "$tmp_ips" -o "$tmp_ips"

  while IFS= read -r ip_addr; do
    [[ -n $ip_addr ]] || continue

    {
      if is_ipv6 "$ip_addr"; then
        timeout --kill-after=0.1s "$ping_timeout" \
          ping -6 -c 1 -W 1 "$ip_addr" >/dev/null 2>&1 || true
      else
        timeout --kill-after=0.1s "$ping_timeout" \
          ping -4 -c 1 -W 1 "$ip_addr" >/dev/null 2>&1 || true
      fi
    } &
  done <"$tmp_ips"

  wait

  printf 'hostname,ipv4,ipv6,mac,services\n'

  while IFS= read -r host; do
    [[ -n $host ]] || continue

    local ipv4="${ipv4_by_host["$host"]:-}"
    local ipv6="${ipv6_by_host["$host"]:-}"
    local mac=""
    local services="${services_by_host["$host"]:-}"

    {
      printf '%s\n' "$ipv4" | tr '|' '\n'
      printf '%s\n' "$ipv6" | tr '|' '\n'
    } | while IFS= read -r ip_addr; do
      ip_addr="${ip_addr#"${ip_addr%%[![:space:]]*}"}"
      ip_addr="${ip_addr%"${ip_addr##*[![:space:]]}"}"

      [[ -n $ip_addr ]] || continue

      if [[ -z ${mac_by_ip["$ip_addr"]+x} ]]; then
        mac_by_ip["$ip_addr"]="$(ip neigh show to "$ip_addr" |
          awk '{print $5; exit}')"
      fi

      if [[ -n ${mac_by_ip["$ip_addr"]:-} ]]; then
        mac="$(append_unique_value "$mac" "${mac_by_ip["$ip_addr"]}" "$cell_delim")"
      fi
    done

    printf '%s,%s,%s,%s,%s\n' \
      "$(csv_escape "$host")" \
      "$(csv_escape "$ipv4")" \
      "$(csv_escape "$ipv6")" \
      "$(csv_escape "$mac")" \
      "$(csv_escape "$services")"
  done <"$tmp_hosts"
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  usage
  exit 0
fi

scan_timeout="${1:-1}"

if ! [[ "$scan_timeout" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  printf 'Invalid timeout: %s\n' "$scan_timeout" >&2
  usage
  exit 1
fi

for cmd in \
  mdns-scan \
  avahi-browse \
  avahi-resolve-host-name \
  timeout \
  ip \
  ping \
  awk \
  sort \
  tee \
  nvim; do
  command -v "$cmd" >/dev/null 2>&1 || {
    printf 'Missing required command: %s\n' "$cmd" >&2
    exit 1
  }
done

tmpdir="$(mktemp -d)"
trap cleanup EXIT
trap on_interrupt INT TERM

tmp_csv="$(mktemp).csv"

scan "$scan_timeout" > "$tmp_csv"

printf '%s\n' "$tmp_csv"

nvim "$tmp_csv" +'%Tabularize /,' +':w'
